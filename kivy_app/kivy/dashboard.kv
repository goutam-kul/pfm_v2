#:kivy 2.3.1

<DashboardScreen>:
    name: "dashboard"
    BoxLayout:
        orientation: "vertical"
        spacing: 10
        padding: 20

        Label:
            text: "Welcome to the Dashboard"
            font_size: 24

        Button:
            text: "Expenses"
            on_release: app.root.current = "expenses"  # Add functionality later

        Button:
            text: "Budgets"
            on_release: app.root.current = "budgets"  # Add functionality later

        Button:
            text: "Logout"
            on_release: app.root.current = "home"
