#:kivy 2.3.1
<ForgotPasswordScreen>:
    name: "forgot_password"

    MDBoxLayout:
        orientation: "vertical"
        spacing: 30
        padding: [20, 50, 20, 20]

        MDLabel:
            text: "Forgot Password"
            font_style: "H4"
            halign: "center"
            theme_text_color: "Custom"
            text_color: [0.2, 0.6, 0.8, 1]

        MDTextField:
            id: email_input
            hint_text: "Enter your email"
            helper_text: "We'll send an OTP to reset your password"
            helper_text_mode: "on_focus"
            icon_left: "email-outline"
            size_hint_x: 0.8
            pos_hint: {"center_x": 0.5}

        MDRaisedButton:
            text: "Send OTP"
            icon: "email-send-outline"
            size_hint: None, None
            size: dp(200), dp(50)
            pos_hint: {"center_x": 0.5}
            md_bg_color: [0.2, 0.6, 0.8, 1]
            text_color: [1, 1, 1, 1]
            on_release: root.send_reset_link(root.ids.email_input.text)

        MDFlatButton:
            text: "Back to Login"
            icon: "keyboard-backspace"
            size_hint: None, None
            size: dp(200), dp(50)
            pos_hint: {"center_x": 0.5}
            text_color: [0.2, 0.6, 0.8, 1]
            on_release: app.root.current = "home"

        MDLabel:
            id: status_label
            text: ""
            halign: "center"
            theme_text_color: "Error"
