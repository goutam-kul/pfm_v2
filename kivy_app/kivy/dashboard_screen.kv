#:kivy 2.3.1

<DashboardScreen>:
    name: "dashboard"

    MDBoxLayout:
        orientation: "vertical"
        spacing: dp(20)
        padding: dp(20)
        md_bg_color: [0.1, 0.1, 0.1, 1]  # Dark background for the dashboard

        MDLabel:
            text: "Welcome to Finance Manager"
            font_style: "H4"
            halign: "center"
            theme_text_color: "Custom"
            text_color: [1, 1, 1, 1]  # White text for visibility

        ScrollView:
            MDBoxLayout:
                orientation: "horizontal"
                spacing: dp(15)
                size_hint_y: None
                height: dp(200)
                padding: dp(10)

                # Expenses Card
                MDCard:
                    orientation: "vertical"
                    size_hint: None, None
                    size: dp(200), dp(180)
                    elevation: 8
                    radius: [15,]
                    md_bg_color: [0.15, 0.15, 0.3, 1]  # Dark blue background
                    ripple_behavior: True
                    on_release: app.root.current = "expense_main"  # Correct screen for Expenses

                    MDIcon:
                        icon: "wallet-outline"
                        halign: "center"
                        font_size: "64sp"
                        theme_text_color: "Custom"
                        text_color: [0.4, 0.7, 1, 1]  # Light blue icon

                    MDLabel:
                        text: "Expenses"
                        halign: "center"
                        font_style: "H6"
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 1]

                # Budgets Card
                MDCard:
                    orientation: "vertical"
                    size_hint: None, None
                    size: dp(200), dp(180)
                    elevation: 8
                    radius: [15,]
                    md_bg_color: [0.2, 0.15, 0.2, 1]  # Dark purple background
                    ripple_behavior: True
                    on_release: app.root.current = "view_budgets"  # Correct screen for Budgets

                    MDIcon:
                        icon: "chart-pie"
                        halign: "center"
                        font_size: "64sp"
                        theme_text_color: "Custom"
                        text_color: [0.8, 0.6, 1, 1]  # Lavender icon

                    MDLabel:
                        text: "Budgets"
                        halign: "center"
                        font_style: "H6"
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 1]

                # Dashboard Card
                MDCard:
                    orientation: "vertical"
                    size_hint: None, None
                    size: dp(200), dp(180)
                    elevation: 8
                    radius: [15,]
                    md_bg_color: [0.25, 0.1, 0.1, 1]  # Dark red background
                    ripple_behavior: True
                    on_release: root.open_streamlit_dashboard()

                    MDIcon:
                        icon: "view-dashboard"  # Change this to the desired icon
                        halign: "center"
                        font_size: "64sp"
                        theme_text_color: "Custom"
                        text_color: [1, 0.8, 0.4, 1]  # Gold color

                    MDLabel:
                        text: "Visit Your Dashboard"
                        halign: "center"
                        font_style: "H6"
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 1]

                # Logout Card
                MDCard:
                    orientation: "vertical"
                    size_hint: None, None
                    size: dp(200), dp(180)
                    elevation: 8
                    radius: [15,]
                    md_bg_color: [0.25, 0.1, 0.1, 1]  # Dark red background
                    ripple_behavior: True
                    on_release: app.root.get_screen("home").logout_user()

                    MDIcon:
                        icon: "logout"
                        halign: "center"
                        font_size: "64sp"
                        theme_text_color: "Custom"
                        text_color: [1, 0.4, 0.4, 1]  # Light red icon

                    MDLabel:
                        text: "Logout"
                        halign: "center"
                        font_style: "H6"
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 1]
